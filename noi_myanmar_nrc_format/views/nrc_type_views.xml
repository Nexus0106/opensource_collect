<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nrc_type_view_tree" model="ir.ui.view">
        <field name="name">nrc.type.view.tree</field>
        <field name="model">nrc.type</field>
        <field name="arch" type="xml">
            <tree string="NRC Citizenship Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="nrc_type_view_form" model="ir.ui.view">
        <field name="name">nrc.type.view.form</field>
        <field name="model">nrc.type</field>
        <field name="arch" type="xml">
            <form string="NRC Citizenship Type">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_type_action" model="ir.actions.act_window">
        <field name="name">NRC Citizenship Types</field>
        <field name="res_model">nrc.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new NRC Citizenship Type
            </p>
        </field>
    </record>

</odoo>
