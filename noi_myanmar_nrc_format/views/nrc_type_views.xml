<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nrc_type_view_tree" model="ir.ui.view">
        <field name="name">nrc.type.view.tree</field>
        <field name="model">nrc.type</field>
        <field name="arch" type="xml">
            <tree string="NRC Type" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="nrc_type_view_form" model="ir.ui.view">
        <field name="name">nrc.type.view.form</field>
        <field name="model">nrc.type</field>
        <field name="arch" type="xml">
            <form string="NRC Type">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_type_action" model="ir.actions.act_window">
        <field name="name">NRC Type</field>
        <field name="res_model">nrc.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create NRC Type (N, P, A, T)
            </p>
        </field>
    </record>
</odoo>
