<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nrc_type_view_tree" model="ir.ui.view">
        <field name="name">nrc.type.tree</field>
        <field name="model">nrc.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nrc_type_view_form" model="ir.ui.view">
        <field name="name">nrc.type.form</field>
        <field name="model">nrc.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" invisible="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_type_view_search" model="ir.ui.view">
        <field name="name">nrc.type.search</field>
        <field name="model">nrc.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="nrc_type_action" model="ir.actions.act_window">
        <field name="name">NRC Types</field>
        <field name="res_model">nrc.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first NRC Type
            </p>
            <p>NRC Types include N (Citizen), E (Associate), P (Naturalized), etc.</p>
        </field>
    </record>

    <menuitem id="menu_nrc_type"
              name="NRC Types"
              parent="menu_nrc_config_root"
              action="nrc_type_action"
              sequence="30"/>
</odoo>
