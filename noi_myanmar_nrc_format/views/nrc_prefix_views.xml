<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nrc_prefix_view_tree" model="ir.ui.view">
        <field name="name">nrc.prefix.tree</field>
        <field name="model">nrc.prefix</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="nrc_prefix_view_form" model="ir.ui.view">
        <field name="name">nrc.prefix.form</field>
        <field name="model">nrc.prefix</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_prefix_view_search" model="ir.ui.view">
        <field name="name">nrc.prefix.search</field>
        <field name="model">nrc.prefix</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="nrc_prefix_action" model="ir.actions.act_window">
        <field name="name">NRC Prefix</field>
        <field name="res_model">nrc.prefix</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new NRC Prefix
            </p>
        </field>
    </record>

</odoo>
