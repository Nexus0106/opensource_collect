<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nrc_prefix_view_tree" model="ir.ui.view">
        <field name="name">nrc.prefix.view.tree</field>
        <field name="model">nrc.prefix</field>
        <field name="arch" type="xml">
            <tree string="NRC State/Region Prefixes" editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="nrc_prefix_view_form" model="ir.ui.view">
        <field name="name">nrc.prefix.view.form</field>
        <field name="model">nrc.prefix</field>
        <field name="arch" type="xml">
            <form string="NRC State/Region Prefix">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_prefix_action" model="ir.actions.act_window">
        <field name="name">NRC State/Region Prefixes</field>
        <field name="res_model">nrc.prefix</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new NRC State/Region Prefix
            </p>
        </field>
    </record>

</odoo>
