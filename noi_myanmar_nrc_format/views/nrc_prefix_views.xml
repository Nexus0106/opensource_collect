<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nrc_prefix_view_tree" model="ir.ui.view">
        <field name="name">nrc.prefix.tree</field>
        <field name="model">nrc.prefix</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nrc_prefix_view_form" model="ir.ui.view">
        <field name="name">nrc.prefix.form</field>
        <field name="model">nrc.prefix</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="active" invisible="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_prefix_view_search" model="ir.ui.view">
        <field name="name">nrc.prefix.search</field>
        <field name="model">nrc.prefix</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="nrc_prefix_action" model="ir.actions.act_window">
        <field name="name">NRC Prefixes</field>
        <field name="res_model">nrc.prefix</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first NRC Prefix
            </p>
            <p>NRC Prefixes represent State/Division codes in Myanmar NRC format.</p>
        </field>
    </record>

    <menuitem id="menu_nrc_config_root"
              name="NRC Configuration"
              parent="contacts.res_partner_menu_config"
              sequence="100"/>

    <menuitem id="menu_nrc_prefix"
              name="NRC Prefixes"
              parent="menu_nrc_config_root"
              action="nrc_prefix_action"
              sequence="10"/>
</odoo>
