<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nrc_township_code_view_tree" model="ir.ui.view">
        <field name="name">nrc.township.code.view.tree</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <tree string="NRC Township Code" editable="bottom">
                <field name="prefix_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="nrc_township_code_view_form" model="ir.ui.view">
        <field name="name">nrc.township.code.view.form</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <form string="NRC Township Code">
                <sheet>
                    <group>
                        <field name="prefix_id"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_township_code_action" model="ir.actions.act_window">
        <field name="name">NRC Township Code</field>
        <field name="res_model">nrc.township.code</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create NRC Township Code (e.g., PAMANA)
            </p>
        </field>
    </record>
</odoo>
