<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nrc_township_code_view_tree" model="ir.ui.view">
        <field name="name">nrc.township.code.tree</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="prefix_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="nrc_township_code_view_form" model="ir.ui.view">
        <field name="name">nrc.township.code.form</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., TaMaNA"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="prefix_id"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_township_code_view_search" model="ir.ui.view">
        <field name="name">nrc.township.code.search</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="prefix_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_prefix" string="Prefix" context="{'group_by': 'prefix_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="nrc_township_code_action" model="ir.actions.act_window">
        <field name="name">NRC Township Codes</field>
        <field name="res_model">nrc.township.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first NRC Township Code
            </p>
            <p>
                Township codes are specific to each State/Division prefix.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_nrc_township_code"
        name="NRC Township Codes"
        parent="menu_nrc_config_root"
        action="nrc_township_code_action"
        sequence="20"/>
</odoo>
