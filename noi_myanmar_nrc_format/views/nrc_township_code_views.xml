<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nrc_township_code_view_tree" model="ir.ui.view">
        <field name="name">nrc.township.code.view.tree</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <tree string="NRC Township Codes" editable="bottom">
                <field name="prefix_id"/>
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="nrc_township_code_view_form" model="ir.ui.view">
        <field name="name">nrc.township.code.view.form</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <form string="NRC Township Code">
                <sheet>
                    <group>
                        <group>
                            <field name="prefix_id"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_township_code_view_search" model="ir.ui.view">
        <field name="name">nrc.township.code.view.search</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <search string="Search Township Codes">
                <field name="code"/>
                <field name="name"/>
                <field name="prefix_id"/>
                <group expand="0" string="Group By">
                    <filter string="State/Region" name="group_by_prefix" context="{'group_by': 'prefix_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="nrc_township_code_action" model="ir.actions.act_window">
        <field name="name">NRC Township Codes</field>
        <field name="res_model">nrc.township.code</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new NRC Township Code
            </p>
        </field>
    </record>

</odoo>
