<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nrc_township_code_view_tree" model="ir.ui.view">
        <field name="name">nrc.township.code.tree</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="prefix_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="nrc_township_code_view_form" model="ir.ui.view">
        <field name="name">nrc.township.code.form</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="prefix_id"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="active" invisible="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nrc_township_code_view_search" model="ir.ui.view">
        <field name="name">nrc.township.code.search</field>
        <field name="model">nrc.township.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="prefix_id"/>
                <field name="code"/>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_prefix" string="NRC Prefix" context="{'group_by': 'prefix_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="nrc_township_code_action" model="ir.actions.act_window">
        <field name="name">NRC Township Codes</field>
        <field name="res_model">nrc.township.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first NRC Township Code
            </p>
            <p>Township codes are linked to NRC Prefixes.</p>
        </field>
    </record>

    <menuitem id="menu_nrc_township_code"
              name="NRC Township Codes"
              parent="menu_nrc_config_root"
              action="nrc_township_code_action"
              sequence="20"/>
</odoo>
