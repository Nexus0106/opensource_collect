<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="webclient_bootstrap_dark_mode" inherit_id="web.webclient_bootstrap">
        <xpath expr="//t[@t-set='body_classname']" position="replace">
            <t t-set="body_classname" t-value="'o_web_client' + (' o_main_menu_dark' if request.httprequest.cookies.get('color_scheme') == 'dark' else '')"/>
        </xpath>
        <xpath expr="//meta[@name='theme-color']" position="replace">
            <meta name="theme-color" t-att-content="'#1f202b' if request.httprequest.cookies.get('color_scheme') == 'dark' else '#71639e'"/>
        </xpath>
    </template>
</odoo>
