<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form View Extension -->
    <record id="view_order_form_target_discount" model="ir.ui.view">
        <field name="name">sale.order.form.target.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Target Discount section below Terms and Conditions (note field) -->
            <xpath expr="//field[@name='note']" position="after">
                <group string="Target Discount Information" invisible="not partner_id">
                    <field name="historical_invoice_total" readonly="1"/>
                    <field name="target_discount_percentage" readonly="1"/>
                    <field name="target_discount_amount" readonly="1"/>
                    <field name="has_target_discount" invisible="1"/>
                    <div>
                        <button name="action_apply_target_discount"
                                type="object"
                                string="Apply Target Discount"
                                class="btn-primary"
                                invisible="target_discount_percentage == 0 or has_target_discount or state not in ('draft', 'sent')"/>
                        <button name="action_remove_target_discount"
                                type="object"
                                string="Remove Target Discount"
                                class="btn-secondary ms-2"
                                invisible="not has_target_discount or state not in ('draft', 'sent')"/>
                    </div>
                </group>
            </xpath>

            <!-- Add is_target_discount_line to order lines tree -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="is_target_discount_line" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
