<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_target_discount_template" model="product.template">
            <field name="name">Target Discount</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">0.0</field>
            <field name="invoice_policy">order</field>
            <field name="is_target_discount">True</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="description_sale">Global target discount based on historical invoice totals</field>
        </record>
    </data>
</odoo>
